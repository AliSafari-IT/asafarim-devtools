{
  "name": "asafarim-devtools",
  "version": "0.5.0",
  "description": "ASafariM DevTools — showcase site for npm packages published under the @asafarim scope.",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "encrypt": "envage encrypt --env local",
    "decrypt": "envage decrypt --env local",
    "encrypt:prod": "envage encrypt --env prod",
    "decrypt:prod": "envage decrypt --env prod",
    "redeploy": "powershell -ExecutionPolicy Bypass -File redeploy.ps1",
    "vps:inspect": "ssh asm 'df -h /; docker system df'",
    "vps:clean": "ssh asm 'df -h /; docker system df'"
  },
  "dependencies": {
    "next": "16.3.5",
    "nodemailer": "^9.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@asafarim/envage": "0.4.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "globals": "^17.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
