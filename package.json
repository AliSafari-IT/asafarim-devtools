{
  "name": "asafarim-devtools",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "encrypt": "envage encrypt --env local",
    "decrypt": "envage decrypt --env local",
    "encrypt:prod": "envage encrypt --env prod",
    "decrypt:prod": "envage decrypt --env prod",
    "redeploy": "powershell -ExecutionPolicy Bypass -File redeploy.ps1",
    "vps:inspect": "ssh asm 'df -h /; docker system df'",
    "vps:clean": "ssh asm 'df -h /; docker system df'"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@asafarim/envage": "0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "globals": "^17.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
